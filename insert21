// SQL query
$sql = "INSERT INTO students_India (id,firstname, lastname, email) 
VALUES (?,?, ?, ?)";

// Prepare the SQL query
if ($stmt = $conn->prepare($sql)) {

    // Bind parameters
    $stmt->bind_param("isss",$id, $firstname, $lastname, $email);

    // Record
    $id = 15;
    $firstname = "Indresh";
    $lastname = "Doe";
    $email = "indresh@example.com";

    $stmt->execute();

